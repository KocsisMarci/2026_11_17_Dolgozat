<Window x:Class="_2026_11_17_Dolgozat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2026_11_17_Dolgozat"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="20 15 0 0"></Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="20 15 0 0"></Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Width" Value="100"></Setter>
            <Setter Property="Height" Value="30"></Setter>
            <Setter Property="Margin" Value="22.5 20"></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"></Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        
    </Window.Resources>
    <Grid ShowGridLines="False">
      
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
        <DataGrid x:Name="dataGrid" Width="800" Height="300" Margin="0 30 0 0" ></DataGrid>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <WrapPanel>
            <Label Content="Név:"></Label>
            <TextBox x:Name="nev" Width="100"></TextBox>
            <Label Content="Életkor:"></Label>
            <TextBox x:Name="eletkor" Width="50"></TextBox>
            <Label Content="Pontszám:"></Label>
             <TextBox x:Name="pontszam" Width="50"></TextBox>

            </WrapPanel>
            <!--A WrapPanel lényegében a StackPanel vízszintesen de neki kis leher orientationt állítani, szóval kb ugyanaz a 2.-->

            <WrapPanel>
                <Button Content="Hozzáadás" Click="hozzaad"></Button>
                <Button Content="Mentés" Click="mentes"></Button>
            </WrapPanel>
        </StackPanel> 
    </Grid>
</Window>
